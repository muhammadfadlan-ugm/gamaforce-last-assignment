<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="maze">
    <static>true</static>
    <link name="maze_link">

      <!-- Bagian Visual: Menggunakan GLB agar warna/tekstur dari Blender tampil -->
      <visual name="maze_visual">
        <geometry>
          <mesh>
            <uri>model://MAZE/mesh/MAZETOK.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Bagian Collision: Menggunakan STL agar fisika benturan ringan dan presisi -->
      <collision name="maze_collision">
        <geometry>
          <mesh>
            <uri>model://MAZE/mesh/MAZETOK.stl</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
