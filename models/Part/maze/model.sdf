<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="maze">

    <!-- Maze tidak bergerak -->
    <static>true</static>

    <link name="maze_link">

      <!-- VISUAL GEOMETRY: GLB -->
      <visual name="maze_visual">
	<pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>Maze.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- COLLISION GEOMETRY: STL -->
      <collision name="maze_collision">
        <geometry>
          <mesh>
            <uri>Maze.stl</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
