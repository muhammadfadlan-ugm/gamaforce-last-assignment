<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tunnel">
    <static>true</static>
    <link name="tunnel_link">

      <!-- Bagian Visual: GLB (sumbu atas Y). Di world model ini diputar roll 90 supaya berdiri/rebah dengan benar. -->
      <visual name="tunnel_visual">
        <geometry>
          <mesh>
            <uri>model://tunnel/mesh/Maze P2.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Bagian Collision: STL (sumbu atas Z).
           Pose roll -90 meniadakan roll 90 dari world, sehingga collision tepat menempel pada visual.
           Jangan dihapus selama include di world masih memakai roll 1.5708. -->
      <collision name="tunnel_collision">
        <pose degrees="true">0 0 0 -90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://tunnel/mesh/Maze P2.stl</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
