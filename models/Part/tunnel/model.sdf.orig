<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tunnel">
    <static>true</static>
    <link name="tunnel_link">

      <!-- Bagian Visual: Menggunakan GLB agar warna/tekstur dari Blender tampil -->
      <visual name="tunnel_visual">
        <geometry>
          <mesh>
            <uri>model://tunnel/mesh/Maze P2.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Bagian Collision: Menggunakan STL agar fisika benturan ringan dan presisi -->
      <collision name="tunnel_collision">
        <geometry>
          <mesh>
            <uri>model://tunnel/mesh/Maze P2.stl</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
